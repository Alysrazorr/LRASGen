    "/api/bessj/{n}/{x}": {
      "get": {
        "operationId": "getBessj",
        "summary": null,
        "description": null,
        "parameters": [
          {
            "name": "n",
            "in": "path",
            "required": true,
            "description": "First edge",
            "schema": {
              "type": "integer",
              "description": "First edge"
            }
          },
          {
            "name": "x",
            "in": "path",
            "required": true,
            "description": "Second edge",
            "schema": {
              "type": "number",
              "description": "Second edge"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing the Bessel function result as a double.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Dto": {
                      "type": "string",
                      "description": "{'resultAsInt': 'integer', 'resultAsDouble': 'double'}"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request when n is less than or equal to 2 or greater than 1000."
          }
        }
      }
    },
