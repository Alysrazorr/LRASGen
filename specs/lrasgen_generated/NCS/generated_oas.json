              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Dto": {
                      "type": "string",
                      "description": "{'resultAsInt': 'integer', 'resultAsDouble': 'double'}"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Returned when either a or b is outside the range [-10000, 10000]."
          }
        }
      }
    },
